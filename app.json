{
  "expo": {
    "name": "Kizen",
    "slug": "Kizen",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/splash-icons.png",
    "scheme": "mobile",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/images/foregroundImage.png",
        "monochromeImage": "./assets/images/monochromeImage.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.khizar_asim.Kizen"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/splash-icons.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icons.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#000000",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-web-browser",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "8833bbc1-4253-485d-a40e-98e64de554c9"
      }
    }
  }
}
